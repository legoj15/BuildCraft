{
 "name": "crossmod-energy-notre",
 "description": "Issue #186 on Fabric: BuildCraft's FE blocks with no Team Reborn Energy loaded (a 26.x runClient has none without the `tre` alias): the blocks place, open their GUIs and nothing is logged. Generated by generators/gen_crossmod_energy.py.",
 "mods": [],
 "loaders": [
  "fabric"
 ],
 "save": "bc-xmod-energy-notre",
 "saveSeed": "bc-smoke",
 "freshSave": true,
 "base": [
  0,
  150,
  0
 ],
 "steps": [
  {
   "label": "creative, daylight, the rig's chunks loaded",
   "do": "cmd",
   "run": [
    "gamemode creative @p",
    "difficulty peaceful",
    "time set day",
    "weather clear",
    "?forceload add {X-16} {Z-16} {X+32} {Z+32}"
   ]
  },
  {
   "do": "tp",
   "at": [
    4,
    2,
    -4
   ],
   "yaw": 0,
   "pitch": 20
  },
  {
   "do": "wait",
   "ms": 3000
  },
  {
   "label": "a fresh rig",
   "do": "cmd",
   "run": [
    "fill {X-4} {Y-8} {Z-4} {X+12} {Y-1} {Z+12} minecraft:stone",
    "fill {X-4} {Y} {Z-4} {X+12} {Y+6} {Z+12} minecraft:air"
   ]
  },
  {
   "label": "creative engine, dynamo and FE engine on redstone blocks, a Mining Well after the FE engine",
   "do": "cmd",
   "run": [
    "setblock {X} {Y-1} {Z} minecraft:redstone_block",
    "setblock {X} {Y} {Z} buildcraftunofficial:engine_creative[facing=east]",
    "setblock {X+1} {Y-1} {Z} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z} buildcraftunofficial:mj_dynamo[facing=east]",
    "setblock {X+1} {Y-1} {Z+4} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+4} buildcraftunofficial:engine_rf[facing=east]",
    "setblock {X+2} {Y} {Z+4} buildcraftunofficial:mining_well",
    "setblock {X+6} {Y} {Z} buildcraftunofficial:engine_rf",
    "setblock {X+8} {Y} {Z} buildcraftunofficial:mj_dynamo"
   ]
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "do": "tp",
   "at": [
    4,
    3,
    -3
   ],
   "yaw": 0,
   "pitch": 30
  },
  {
   "do": "wait",
   "ms": 1000
  },
  {
   "name": "notre-blocks",
   "do": "shot",
   "look": "a creative engine and dynamo (left), an FE engine and Mining Well (further along), two idle converters on the right: all drawn as blocks, no error"
  },
  {
   "label": "the dynamo holds MJ but nowhere to send FE: still placed",
   "do": "cmd",
   "run": [
    "execute if block {X+1} {Y} {Z} buildcraftunofficial:mj_dynamo"
   ]
  },
  {
   "label": "the FE engine is still placed",
   "do": "cmd",
   "run": [
    "execute if block {X+1} {Y} {Z+4} buildcraftunofficial:engine_rf"
   ]
  },
  {
   "label": "the FE engine's buffer (expect 0: no FE source can reach it)",
   "do": "cmd",
   "run": [
    "data get block {X+1} {Y} {Z+4} currentFe"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "the Mining Well did NOT dig (no FE, no MJ)",
   "do": "cmd",
   "run": [
    "execute unless block {X+2} {Y-1} {Z+4} buildcraftunofficial:tube"
   ]
  },
  {
   "do": "hold",
   "item": "minecraft:air"
  },
  {
   "do": "tp",
   "at": [
    6,
    0,
    -3
   ],
   "yaw": 0,
   "pitch": 15
  },
  {
   "do": "aim",
   "at": [
    6,
    0,
    0
   ]
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "label": "open the FE engine",
   "do": "use"
  },
  {
   "do": "expectScreen",
   "contains": "ScreenEngineFE",
   "timeoutSec": 10
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "name": "notre-gui-screenenginefe",
   "do": "shot",
   "look": "the FE engine GUI opens and draws its slots, gauge and title"
  },
  {
   "do": "close"
  },
  {
   "do": "hold",
   "item": "minecraft:air"
  },
  {
   "do": "tp",
   "at": [
    8,
    0,
    -3
   ],
   "yaw": 0,
   "pitch": 15
  },
  {
   "do": "aim",
   "at": [
    8,
    0,
    0
   ]
  },
  {
   "do": "wait",
   "ms": 400
  },
  {
   "label": "open the MJ dynamo",
   "do": "use"
  },
  {
   "do": "expectScreen",
   "contains": "ScreenDynamoMJ",
   "timeoutSec": 10
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "name": "notre-gui-screendynamomj",
   "do": "shot",
   "look": "the MJ dynamo GUI opens and draws its slots, gauge and title"
  },
  {
   "do": "close"
  }
 ]
}
