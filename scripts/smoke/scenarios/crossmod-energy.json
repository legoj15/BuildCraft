{
 "name": "crossmod-energy",
 "description": "Issue #186: BuildCraft's FE engine and MJ dynamo against Energized Power (both loaders) and Tech Reborn (Fabric, through Team Reborn Energy), both directions. Generated by generators/gen_crossmod_energy.py, whose docstring describes the lanes.",
 "mods": [
  "tre",
  "energizedpower",
  "techreborn"
 ],
 "loaders": [
  "neoforge",
  "fabric"
 ],
 "save": "bc-xmod-energy",
 "saveSeed": "bc-smoke",
 "freshSave": true,
 "base": [
  0,
  150,
  0
 ],
 "steps": [
  {
   "label": "creative, daylight, the rig's chunks loaded",
   "do": "cmd",
   "run": [
    "gamemode creative @p",
    "difficulty peaceful",
    "time set day",
    "weather clear",
    "?forceload add {X-16} {Z-16} {X+32} {Z+32}"
   ]
  },
  {
   "do": "tp",
   "at": [
    8,
    4,
    -4
   ],
   "yaw": 0,
   "pitch": 25
  },
  {
   "do": "wait",
   "ms": 3000
  },
  {
   "label": "a fresh rig: stone floor (Mining Wells dig down into it), air above",
   "do": "cmd",
   "run": [
    "fill {X-4} {Y-8} {Z-4} {X+12} {Y-1} {Z+28} minecraft:stone",
    "fill {X-4} {Y} {Z-4} {X+12} {Y+6} {Z+28} minecraft:air"
   ]
  },
  {
   "label": "lane 1: creative engine and dynamo, each on a redstone block",
   "do": "cmd",
   "run": [
    "setblock {X} {Y-1} {Z} minecraft:redstone_block",
    "setblock {X} {Y} {Z} buildcraftunofficial:engine_creative[facing=east]",
    "setblock {X+1} {Y-1} {Z} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z} buildcraftunofficial:mj_dynamo[facing=east]",
    "setblock {X+2} {Y} {Z} energizedpower:battery_box"
   ]
  },
  {
   "label": "lane 2: creative engine and dynamo, each on a redstone block",
   "do": "cmd",
   "run": [
    "setblock {X} {Y-1} {Z+4} minecraft:redstone_block",
    "setblock {X} {Y} {Z+4} buildcraftunofficial:engine_creative[facing=east]",
    "setblock {X+1} {Y-1} {Z+4} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+4} buildcraftunofficial:mj_dynamo[facing=east]",
    "setblock {X+2} {Y} {Z+4} energizedpower:copper_cable",
    "setblock {X+3} {Y} {Z+4} energizedpower:copper_cable",
    "setblock {X+4} {Y} {Z+4} energizedpower:battery_box"
   ]
  },
  {
   "label": "lane 3: creative engine and dynamo, each on a redstone block",
   "do": "cmd",
   "run": [
    "setblock {X} {Y-1} {Z+8} minecraft:redstone_block",
    "setblock {X} {Y} {Z+8} buildcraftunofficial:engine_creative[facing=east]",
    "setblock {X+1} {Y-1} {Z+8} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+8} buildcraftunofficial:mj_dynamo[facing=east]",
    "setblock {X+2} {Y} {Z+8} techreborn:low_voltage_su"
   ],
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 4: creative engine and dynamo, each on a redstone block",
   "do": "cmd",
   "run": [
    "setblock {X} {Y-1} {Z+12} minecraft:redstone_block",
    "setblock {X} {Y} {Z+12} buildcraftunofficial:engine_creative[facing=east]",
    "setblock {X+1} {Y-1} {Z+12} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+12} buildcraftunofficial:mj_dynamo[facing=east]",
    "setblock {X+2} {Y} {Z+12} techreborn:copper_cable",
    "setblock {X+3} {Y} {Z+12} techreborn:low_voltage_su"
   ],
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 5: Energized Power's creative battery box feeding an FE engine feeding a Mining Well",
   "do": "cmd",
   "run": [
    "setblock {X} {Y} {Z+16} energizedpower:creative_battery_box",
    "setblock {X+1} {Y-1} {Z+16} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+16} buildcraftunofficial:engine_rf[facing=east]",
    "setblock {X+2} {Y} {Z+16} buildcraftunofficial:mining_well"
   ]
  },
  {
   "label": "lane 6: Tech Reborn's creative solar panel feeding an FE engine feeding a Mining Well",
   "do": "cmd",
   "run": [
    "setblock {X} {Y} {Z+20} techreborn:creative_solar_panel",
    "setblock {X+1} {Y-1} {Z+20} minecraft:redstone_block",
    "setblock {X+1} {Y} {Z+20} buildcraftunofficial:engine_rf[facing=east]",
    "setblock {X+2} {Y} {Z+20} buildcraftunofficial:mining_well"
   ],
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "do": "tp",
   "at": [
    17,
    12,
    10
   ],
   "yaw": 90,
   "pitch": 30
  },
  {
   "do": "wait",
   "ms": 2500
  },
  {
   "name": "lanes-early",
   "do": "shot",
   "look": "six lanes in a row along Z (lanes 3, 4 and 6 empty where Tech Reborn is not loaded), each starting with a creative engine and a dynamo (lanes 1 to 4) or an Energized Power / Tech Reborn block beside an FE engine and a Mining Well (lanes 5, 6)"
  },
  {
   "label": "lane 1: the EP battery box holds energy",
   "do": "waitCmd",
   "run": "data get block {X+2} {Y} {Z}",
   "match": "energy: [1-9]\\d*L?[,}]",
   "timeoutSec": 60,
   "pollMs": 1000
  },
  {
   "label": "lane 2: the battery box behind the EP cables holds energy",
   "do": "waitCmd",
   "run": "data get block {X+4} {Y} {Z+4}",
   "match": "energy: [1-9]\\d*L?[,}]",
   "timeoutSec": 60,
   "pollMs": 1000
  },
  {
   "label": "lane 3: the TR LV storage unit holds energy",
   "do": "waitCmd",
   "run": "data get block {X+2} {Y} {Z+8} PowerAcceptor.energy",
   "match": "[1-9]\\d*L",
   "timeoutSec": 60,
   "pollMs": 1000,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 4: the TR LV storage unit behind the TR cable holds energy",
   "do": "waitCmd",
   "run": "data get block {X+3} {Y} {Z+12} PowerAcceptor.energy",
   "match": "[1-9]\\d*L",
   "timeoutSec": 60,
   "pollMs": 1000,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 5: the FE engine took FE from the EP creative battery box",
   "do": "waitCmd",
   "run": "data get block {X+1} {Y} {Z+16} currentFe",
   "match": "block data: [1-9]\\d*$",
   "timeoutSec": 60,
   "pollMs": 1000
  },
  {
   "label": "lane 5: the Mining Well ran on it (a tube stands below the well)",
   "do": "waitCmd",
   "run": "execute if block {X+2} {Y-1} {Z+16} buildcraftunofficial:tube",
   "match": "passed",
   "timeoutSec": 90,
   "pollMs": 1000
  },
  {
   "label": "lane 6: the FE engine took FE from the TR creative solar panel",
   "do": "waitCmd",
   "run": "data get block {X+1} {Y} {Z+20} currentFe",
   "match": "block data: [1-9]\\d*$",
   "timeoutSec": 60,
   "pollMs": 1000,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 6: the Mining Well ran on it (a tube stands below the well)",
   "do": "waitCmd",
   "run": "execute if block {X+2} {Y-1} {Z+20} buildcraftunofficial:tube",
   "match": "passed",
   "timeoutSec": 90,
   "pollMs": 1000,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "do": "wait",
   "ms": 2000
  },
  {
   "do": "tp",
   "at": [
    17,
    12,
    10
   ],
   "yaw": 90,
   "pitch": 30
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "lanes-late",
   "do": "shot",
   "look": "the same six lanes after the energy moved (lanes 3, 4 and 6 empty where Tech Reborn is not loaded): lanes 5 and 6 have a pipe-like tube below their Mining Well; the engines in lanes 5 and 6 are lit (FE engines burning)"
  },
  {
   "label": "lane 1: EP battery box",
   "do": "cmd",
   "run": [
    "data get block {X+2} {Y} {Z}"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "lane 2: EP battery box behind the cables",
   "do": "cmd",
   "run": [
    "data get block {X+4} {Y} {Z+4}"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "lane 5: FE engine",
   "do": "cmd",
   "run": [
    "data get block {X+1} {Y} {Z+16} currentFe"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "lane 3: TR LV unit",
   "do": "cmd",
   "run": [
    "data get block {X+2} {Y} {Z+8} PowerAcceptor.energy"
   ],
   "allowFail": true,
   "echo": true,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 4: TR LV unit behind the cable",
   "do": "cmd",
   "run": [
    "data get block {X+3} {Y} {Z+12} PowerAcceptor.energy"
   ],
   "allowFail": true,
   "echo": true,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
    "26.3"
   ],
   "loaders": [
    "fabric"
   ]
  },
  {
   "label": "lane 6: FE engine",
   "do": "cmd",
   "run": [
    "data get block {X+1} {Y} {Z+20} currentFe"
   ],
   "allowFail": true,
   "echo": true,
   "nodes": [
    "1.21.1",
    "26.1.2",
    "26.2",
