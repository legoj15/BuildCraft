   ]
  },
  {
   "label": "load the rig's chunks",
   "do": "cmd",
   "benign": true,
   "run": [
    "forceload add {X-14} {Z-8} {X+14} {Z+4}"
   ]
  },
  {
   "do": "tp",
   "at": [
    0,
    0,
    2
   ],
   "yaw": 180,
   "pitch": 30
  },
  {
   "do": "wait",
   "ms": 3000
  },
  {
   "label": "floor, noon, empty inventory",
   "do": "cmd",
   "benign": true,
   "run": [
    "difficulty peaceful",
    "time set 6000",
    "weather clear",
    "fill {X-14} {Y-1} {Z-8} {X+14} {Y-1} {Z+4} minecraft:smooth_stone",
    "fill {X-14} {Y} {Z-8} {X+14} {Y+4} {Z+4} minecraft:air",
    "clear @p"
