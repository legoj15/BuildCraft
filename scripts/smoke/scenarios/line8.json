{
  "name": "line8",
  "description": "The in-client checklist in docs/todo-details.md#in-client-smoke-2026-09-26: render sites, machine GUIs with button tooltips, the guide book.",
  "base": [0, 150, 0],
  "steps": [
    { "label": "setup", "do": "cmd", "run": [
      "gamemode creative @p", "difficulty peaceful", "time set 6000", "weather clear",
      "fill {X-8} {Y-1} {Z-8} {X+8} {Y-1} {Z+16} minecraft:smooth_stone",
      "?fill {X-8} {Y} {Z-8} {X+8} {Y+6} {Z+16} minecraft:air"
    ] },

    { "label": "render rig", "do": "cmd", "run": [
      "setblock {X-3} {Y-1} {Z} minecraft:redstone_block",
      "setblock {X-3} {Y} {Z} buildcraftunofficial:engine_creative[facing=east]",
      "setblock {X-2} {Y} {Z} buildcraftunofficial:pipe_holder",
      "data merge block {X-2} {Y} {Z} {pipe:{def:\"buildcraftunofficial:wood_power\"}}",
      "setblock {X-1} {Y} {Z} buildcraftunofficial:pipe_holder",
      "data merge block {X-1} {Y} {Z} {pipe:{def:\"buildcraftunofficial:stone_power\"}}",
      "setblock {X} {Y} {Z} buildcraftunofficial:power_tester",
      "setblock {X+2} {Y} {Z} buildcraftunofficial:tank",
      "setblock {X+4} {Y} {Z} buildcraftunofficial:distiller",
      "setblock {X+6} {Y} {Z} buildcraftunofficial:heat_exchange",
      "setblock {X-5} {Y} {Z} buildcraftunofficial:laser[facing=up]"
    ] },
    { "do": "tp", "at": [2, 0, 2], "yaw": 180, "pitch": 30 },
    { "do": "hold", "item": "minecraft:water_bucket" },
    { "do": "aim", "at": [2, 0, 0] },
    { "label": "fill tank with water", "do": "use" },
    { "do": "hold", "item": "minecraft:air" },
    { "label": "open tank", "do": "use" },
    { "do": "expectScreen", "contains": "GuiTank" },
    { "name": "tank-gui", "do": "shot", "look": "tank GUI shows the water it was filled with" },
    { "do": "close" },
    { "do": "tp", "at": [0, 0, 6], "yaw": 180, "pitch": 25 },
    { "do": "wait", "ms": 2000 },
    { "name": "render-rig", "do": "shot", "look": "left to right: laser, creative engine (running, facing the pipes), kinesis pipes carrying power (flow visible), power tester, tank with water, distiller, heat exchanger" },

    { "label": "gui row", "do": "cmd", "run": [
      "setblock {X-4} {Y} {Z+12} buildcraftunofficial:builder",
      "setblock {X-2} {Y} {Z+12} buildcraftunofficial:autoworkbench_item",
      "setblock {X} {Y} {Z+12} buildcraftunofficial:filler",
      "data merge block {X} {Y} {Z+12} {markerBox:0b,box_initialized:1b,box_minX:-2,box_minY:151,box_minZ:14,box_maxX:2,box_maxY:153,box_maxZ:16}",
      "setblock {X+2} {Y} {Z+12} buildcraftunofficial:pipe_holder",
      "data merge block {X+2} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:diamond_wood_item\"}}",
      "setblock {X+4} {Y} {Z+12} buildcraftunofficial:pipe_holder",
      "data merge block {X+4} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:emzuli_item\"}}"
    ] },

    { "do": "tp", "at": [-4, 0, 10], "yaw": 0, "pitch": 30 }, { "do": "aim", "at": [-4, 0, 12] },
    { "label": "open builder", "do": "use" }, { "do": "expectScreen", "contains": "GuiBuilder" },
    { "name": "builder", "do": "shot" }, { "name": "builder", "do": "hoverEach" }, { "do": "close" },

    { "do": "tp", "at": [-2, 0, 10], "yaw": 0, "pitch": 30 }, { "do": "aim", "at": [-2, 0, 12] },
    { "label": "open auto workbench", "do": "use" }, { "do": "expectScreen", "contains": "GuiAutoCraftItems" },
    { "name": "autoworkbench", "do": "shot" }, { "name": "autoworkbench", "do": "hoverEach" }, { "do": "close" },

    { "do": "tp", "at": [0, 0, 10], "yaw": 0, "pitch": 30 }, { "do": "aim", "at": [0, 0, 12] },
    { "label": "open filler", "do": "use" }, { "do": "expectScreen", "contains": "GuiFiller" },
    { "name": "filler", "do": "shot", "look": "vanilla-face buttons, pressed-in mode, ledgers; JEI's page arrow vs the owner ledger at top-right" },
    { "name": "filler", "do": "hoverEach" }, { "do": "close" },

    { "do": "tp", "at": [2, 0, 10], "yaw": 0, "pitch": 30 }, { "do": "aim", "at": [2, 0, 12] },
    { "label": "open diamond-wood pipe", "do": "use" }, { "do": "expectScreen", "contains": "GuiDiamondWoodPipe" },
    { "name": "diamondwood", "do": "shot", "look": "selected mode shows pressed in; blacklist icon outlined" },
    { "name": "diamondwood", "do": "hoverEach" }, { "do": "close" },

    { "do": "tp", "at": [4, 0, 10], "yaw": 0, "pitch": 30 }, { "do": "aim", "at": [4, 0, 12] },
    { "label": "open emzuli pipe", "do": "use" }, { "do": "expectScreen", "contains": "GuiEmzuliPipe" },
    { "name": "emzuli", "do": "shot" }, { "name": "emzuli", "do": "hoverEach" },
    { "name": "emzuli", "do": "widgets" },
    { "label": "emzuli slot right-click", "do": "click", "slotIndex": 0, "button": 1, "allowMiss": true },
    { "name": "emzuli-right-click", "do": "shot" },
    { "label": "emzuli slot middle-click", "do": "click", "slotIndex": 0, "button": 2, "allowMiss": true },
    { "name": "emzuli-middle-click", "do": "shot" },
    { "do": "close" },

    { "do": "hold", "item": "buildcraftunofficial:list" }, { "do": "look", "yaw": 0, "pitch": -80 },
    { "label": "open list", "do": "use" }, { "do": "expectScreen", "contains": "GuiList" },
    { "name": "list", "do": "shot" }, { "name": "list", "do": "hoverEach" }, { "do": "close" },

    { "do": "hold", "item": "buildcraftunofficial:guide" },
    { "label": "open guide", "do": "use" }, { "do": "expectScreen", "contains": "GuiGuide", "timeoutSec": 20 },
    { "do": "wait", "ms": 500 },
    { "name": "guide-cover", "do": "shot", "look": "the book cover" },
    { "label": "open the book", "do": "click", "x": 213, "y": 120, "allowMiss": true },
    { "do": "wait", "ms": 500 },
    { "name": "guide-page1", "do": "shot" },
    { "label": "hover next page", "do": "hover", "widgetText": "Next Page" },
    { "name": "guide-next-tooltip", "do": "shot", "look": "'Next Page' tooltip, highlighted arrow" },
    { "label": "next page", "do": "click", "widgetText": "Next Page" },
    { "do": "wait", "ms": 400 },
    { "name": "guide-page3", "do": "shot", "look": "contents page: sort buttons, chapter tabs down the left" },
    { "name": "guide-contents", "do": "widgets" },
    { "name": "guide-contents", "do": "hoverEach" },
    { "label": "hover previous page", "do": "hover", "widgetText": "Previous Page" },
    { "name": "guide-prev-tooltip", "do": "shot" },
    { "label": "previous page", "do": "click", "widgetText": "Previous Page" },
    { "do": "wait", "ms": 400 },
    { "label": "open chapters overlay", "do": "click", "x": 250, "y": 3, "allowMiss": true },
    { "do": "wait", "ms": 400 },
    { "name": "guide-chapters", "do": "shot", "look": "chapter overlay: Actions, Blocks, Items, Pipes, Triggers" },
    { "label": "pick the Blocks chapter", "do": "click", "x": 155, "y": 50, "allowMiss": true },
    { "do": "wait", "ms": 400 },
    { "name": "guide-blocks-chapter", "do": "shot", "look": "the Blocks chapter opened (not the page under the overlay)" },
    { "name": "guide-blocks", "do": "widgets" },
    { "label": "hover back", "do": "hover", "widgetText": "Back", "allowMiss": true },
    { "name": "guide-back-tooltip", "do": "shot" },
    { "label": "back", "do": "click", "widgetText": "Back", "allowMiss": true },
    { "do": "wait", "ms": 400 },
    { "name": "guide-after-back", "do": "shot" },
    { "do": "close" },
    { "do": "hold", "item": "minecraft:air" }
  ]
}
