        "?setblock {X+24} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Gold\",\"\",\"\",\"\"]}}",
        "setblock {X+26} {Y} {Z+0} buildcraftunofficial:pipe_holder",
