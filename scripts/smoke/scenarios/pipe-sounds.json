        "data merge block {X+32} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:void_item\"}}",
        "setblock {X+32} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+32} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:void_item\"}}",
