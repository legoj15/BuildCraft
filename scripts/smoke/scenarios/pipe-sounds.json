    },
    {
      "label": "re-sounded blocks (combustion engine keeps the classic metal sound for comparison)",
      "do": "cmd",
      "run": [
        "setblock {X} {Y} {Z+5} buildcraftunofficial:engine_redstone",
        "?setblock {X} {Y} {Z+4} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Redstone eng\",\"\",\"\",\"\"]}}",
        "setblock {X+3} {Y} {Z+5} buildcraftunofficial:engine_stone",
        "?setblock {X+3} {Y} {Z+4} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Stirling eng\",\"\",\"\",\"\"]}}",
        "setblock {X+6} {Y} {Z+5} buildcraftunofficial:engine_iron",
        "?setblock {X+6} {Y} {Z+4} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Combustion (old)\",\"\",\"\",\"\"]}}",
        "setblock {X+9} {Y} {Z+5} buildcraftunofficial:marker_volume",
        "?setblock {X+9} {Y} {Z+4} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Vol marker\",\"\",\"\",\"\"]}}",
