    {
      "do": "tp",
      "at": [
        17,
        0,
        -6
      ],
      "yaw": 0,
      "pitch": 15
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "name": "sounds-rig",
      "do": "shot",
      "look": "a labelled row of pipes, one per material, with engines, markers and a frame behind"
    },
    {
      "label": "HANDS ON: walk, place and break; close the game when done (the poll fails once the client is gone, which ends the run)",
      "do": "waitCmd",
      "run": "time query gametime",
      "match": "^NEVER$",
      "timeoutSec": 10800,
      "pollMs": 3000
    }
