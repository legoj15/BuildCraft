    {
      "label": "every pipe and block in the inventory",
      "do": "cmd",
      "run": [
        "give @p buildcraftunofficial:pipe_structure 64",
        "give @p buildcraftunofficial:pipe_wood_item 64",
        "give @p buildcraftunofficial:pipe_diamond_wood_item 64",
        "give @p buildcraftunofficial:pipe_emzuli_item 64",
        "give @p buildcraftunofficial:pipe_cobble_item 64",
        "give @p buildcraftunofficial:pipe_stone_item 64",
        "give @p buildcraftunofficial:pipe_sandstone_item 64",
        "give @p buildcraftunofficial:pipe_quartz_item 64",
        "give @p buildcraftunofficial:pipe_clay_item 64",
        "give @p buildcraftunofficial:pipe_obsidian_item 64",
        "give @p buildcraftunofficial:pipe_lapis_item 64",
        "give @p buildcraftunofficial:pipe_iron_item 64",
        "give @p buildcraftunofficial:pipe_gold_item 64",
        "give @p buildcraftunofficial:pipe_stripes_item 64",
        "give @p buildcraftunofficial:pipe_diamond_item 64",
        "give @p buildcraftunofficial:pipe_daizuli_item 64",
        "give @p buildcraftunofficial:pipe_void_item 64",
        "give @p buildcraftunofficial:engine_redstone 16",
        "give @p buildcraftunofficial:engine_stone 16",
        "give @p buildcraftunofficial:engine_iron 16",
        "give @p buildcraftunofficial:marker_volume 16",
        "give @p buildcraftunofficial:marker_path 16",
        "give @p buildcraftunofficial:frame 16"
      ]
