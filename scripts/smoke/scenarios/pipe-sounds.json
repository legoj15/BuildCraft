        "data merge block {X+26} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:stripes_item\"}}",
        "setblock {X+26} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+26} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:stripes_item\"}}",
        "?setblock {X+26} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Stripes\",\"\",\"\",\"\"]}}",
        "setblock {X+28} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+28} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:diamond_item\"}}",
        "setblock {X+28} {Y} {Z+1} buildcraftunofficial:pipe_holder",
