        "setblock {X+22} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+22} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:iron_item\"}}",
        "setblock {X+22} {Y} {Z+1} buildcraftunofficial:pipe_holder",
        "data merge block {X+22} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:iron_item\"}}",
        "setblock {X+22} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+22} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:iron_item\"}}",
        "?setblock {X+22} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Iron\",\"\",\"\",\"\"]}}",
        "setblock {X+24} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+24} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:gold_item\"}}",
