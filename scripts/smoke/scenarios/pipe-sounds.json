{
  "name": "pipe-sounds",
  "description": "Hands-on listening rig for per-material pipe sounds (todo line 8): one 3-long run of every pipe material in a labelled row, the re-sounded blocks behind it, every item in the inventory, then a long wait while a person walks on, places and breaks them. Close the game to end.",
  "base": [
    0,
    150,
    0
  ],
  "steps": [
    {
      "label": "clear and floor",
      "do": "cmd",
      "run": [
        "gamemode creative @p",
        "time set 6000",
        "weather clear",
        "?gamerule doDaylightCycle false",
        "?clear @p",
        "?forceload add {X-4} {Z-10} {X+36} {Z+8}",
        "fill {X-4} {Y} {Z-10} {X+36} {Y+4} {Z+8} minecraft:air",
        "fill {X-4} {Y-1} {Z-10} {X+36} {Y-1} {Z+8} minecraft:smooth_stone"
      ]
    },
    {
      "label": "one run of each pipe material, labelled",
      "do": "cmd",
      "run": [
        "setblock {X} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:structure\"}}",
        "setblock {X} {Y} {Z+1} buildcraftunofficial:pipe_holder",
        "data merge block {X} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:structure\"}}",
        "setblock {X} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:structure\"}}",
        "?setblock {X} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Structure\",\"\",\"\",\"\"]}}",
        "setblock {X+2} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+2} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:wood_item\"}}",
        "setblock {X+2} {Y} {Z+1} buildcraftunofficial:pipe_holder",
        "data merge block {X+2} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:wood_item\"}}",
        "setblock {X+2} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+2} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:wood_item\"}}",
        "?setblock {X+2} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Wood\",\"\",\"\",\"\"]}}",
        "setblock {X+4} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+4} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:diamond_wood_item\"}}",
        "setblock {X+4} {Y} {Z+1} buildcraftunofficial:pipe_holder",
        "data merge block {X+4} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:diamond_wood_item\"}}",
        "setblock {X+4} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+4} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:diamond_wood_item\"}}",
        "?setblock {X+4} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Diamond wood\",\"\",\"\",\"\"]}}",
        "setblock {X+6} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+6} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:emzuli_item\"}}",
        "setblock {X+6} {Y} {Z+1} buildcraftunofficial:pipe_holder",
        "data merge block {X+6} {Y} {Z+1} {pipe:{def:\"buildcraftunofficial:emzuli_item\"}}",
        "setblock {X+6} {Y} {Z+2} buildcraftunofficial:pipe_holder",
        "data merge block {X+6} {Y} {Z+2} {pipe:{def:\"buildcraftunofficial:emzuli_item\"}}",
        "?setblock {X+6} {Y} {Z-1} minecraft:oak_sign[rotation=8]{front_text:{messages:[\"Emzuli\",\"\",\"\",\"\"]}}",
        "setblock {X+8} {Y} {Z+0} buildcraftunofficial:pipe_holder",
        "data merge block {X+8} {Y} {Z+0} {pipe:{def:\"buildcraftunofficial:cobblestone_item\"}}",
