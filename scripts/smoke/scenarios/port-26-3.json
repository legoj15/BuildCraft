   "do": "shot",
   "look": "B11: coloured (light fuel, yellow) shard in hand"
  },
  {
   "do": "hold",
   "item": "minecraft:air"
  },
  {
   "label": "chest of items",
   "do": "cmd",
   "run": [
    "setblock {X-11} {Y} {Z} minecraft:chest[facing=south]{Items:[{Slot:0b,id:\"buildcraftunofficial:pipe_wood_item\",count:1},{Slot:1b,id:\"buildcraftunofficial:pipe_stone_fluid\",count:1},{Slot:2b,id:\"buildcraftunofficial:pipe_gold_power\",count:1},{Slot:3b,id:\"buildcraftunofficial:pipe_diamond_item\",count:1},{Slot:4b,id:\"buildcraftunofficial:pipe_structure\",count:1},{Slot:5b,id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_planks\"}}]}}}},{Slot:6b,id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:0b,states:[{state:{id:\"minecraft:stone_bricks\"}}]}}}},{Slot:7b,id:\"buildcraftunofficial:plug_gate\",count:1,components:{\"minecraft:custom_data\":{gate:{logic:0b,material:1b,modifier:0b}}}},{Slot:8b,id:\"buildcraftunofficial:plug_gate\",count:1,components:{\"minecraft:custom_data\":{gate:{logic:1b,material:3b,modifier:3b}}}},{Slot:9b,id:\"buildcraftunofficial:plug_lens\",count:1,components:{\"minecraft:custom_data\":{colour:\"red\",isFilter:0b}}},{Slot:10b,id:\"buildcraftunofficial:plug_lens\",count:1,components:{\"minecraft:custom_data\":{isFilter:1b}}},{Slot:11b,id:\"buildcraftunofficial:plug_blocker\",count:1},{Slot:12b,id:\"buildcraftunofficial:plug_pulsar\",count:1},{Slot:13b,id:\"buildcraftunofficial:plug_light_sensor\",count:1},{Slot:14b,id:\"buildcraftunofficial:plug_timer\",count:1},{Slot:15b,id:\"buildcraftunofficial:plug_power_adaptor\",count:1},{Slot:16b,id:\"buildcraftunofficial:robot\",count:1},{Slot:17b,id:\"buildcraftunofficial:robot_station\",count:1},{Slot:18b,id:\"buildcraftunofficial:wrench\",count:1},{Slot:19b,id:\"buildcraftunofficial:fragile_fluid_container\",count:1,components:{\"buildcraftunofficial:fluid_content\":{id:\"minecraft:lava\",amount:1000}}},{Slot:20b,id:\"buildcraftunofficial:fragile_fluid_container\",count:1,components:{\"buildcraftunofficial:fluid_content\":{id:\"buildcraftunofficial:fuel_light\",amount:1000}}},{Slot:21b,id:\"buildcraftunofficial:fragile_fluid_container\",count:1,components:{\"buildcraftunofficial:fluid_content\":{id:\"buildcraftunofficial:oil\",amount:1000}}},{Slot:22b,id:\"buildcraftunofficial:fragile_fluid_container\",count:1,components:{\"buildcraftunofficial:fluid_content\":{id:\"minecraft:water\",amount:1000}}},{Slot:23b,id:\"buildcraftunofficial:marker_volume\",count:1},{Slot:24b,id:\"buildcraftunofficial:marker_path\",count:1},{Slot:25b,id:\"buildcraftunofficial:gate_copier\",count:1},{Slot:26b,id:\"buildcraftunofficial:paintbrush\",count:1}]}"
   ]
  },
  {
   "do": "tp",
   "at": [
    -11,
    0,
    2
   ],
