   "do": "shot",
   "look": "B2: wooden pipe item in hand"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:plug_facade[minecraft:custom_data={facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_planks\"}}]}}]"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "hand-facade",
   "do": "shot",
   "look": "oak facade item in hand (legacy Name key)"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:plug_gate[minecraft:custom_data={gate:{logic:0b,material:3b,modifier:3b}}]"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "hand-gate",
   "do": "shot",
   "look": "gold diamond-modifier gate item in hand"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:plug_lens[minecraft:custom_data={colour:\"red\",isFilter:0b}]"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "hand-lens",
   "do": "shot",
   "look": "red lens item in hand"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:robot"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "hand-robot",
   "do": "shot",
   "look": "B2: robot (chassis) item in hand"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:fragile_fluid_container[buildcraftunofficial:fluid_content={id:\"minecraft:lava\",amount:1000}]"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "hand-shard-lava",
   "do": "shot",
   "look": "B11: lava fluid shard in hand (orange; red/blue swap is a known 26.2 bug too, not a 26.3 regression)"
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:fragile_fluid_container[buildcraftunofficial:fluid_content={id:\"buildcraftunofficial:fuel_light\",amount:1000}]"
  },
  {
