   "do": "cmd",
   "run": [
    "item replace entity @p inventory.0 with buildcraftunofficial:paintbrush[buildcraftunofficial:brush_color=\"red\",buildcraftunofficial:brush_uses=64]"
   ]
  },
  {
   "do": "tp",
   "at": [
    9,
    0,
    -13
   ],
   "yaw": 180,
   "pitch": 20
  },
  {
   "do": "aim",
   "at": [
    9,
    0,
    -16
   ]
  },
  {
