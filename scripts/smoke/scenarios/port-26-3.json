{
 "name": "port-26-3",
 "description": "26.3 port V2 in-client checks (docs/port-26.3.md section 4): OIT, model shading, pipes and plug items, Stirling fuel and JEI, mouse buttons, guide link and tag recipes, fluid shards, oil feature, wrench. Generated by generators/gen_port_26_3.py: run it on 26.3 (OIT off, then on) and on 26.2, and compare.",
 "base": [
  0,
  150,
  0
 ],
 "steps": [
  {
   "label": "load the rig's chunks",
   "do": "cmd",
   "run": [
    "gamemode creative @p",
    "?forceload add {X-16} {Z-20} {X+16} {Z+24}"
   ]
  },
  {
   "do": "tp",
   "at": [
    0,
    0,
    4
   ],
   "yaw": 180,
   "pitch": 10
  },
  {
   "do": "wait",
   "ms": 3000
  },
  {
   "label": "clear and floor",
   "do": "cmd",
   "run": [
    "difficulty peaceful",
    "time set 6000",
    "weather clear",
    "?clear @p",
    "?kill @e[type=minecraft:item,x={X},y={Y},z={Z},distance=..60]",
    "?fill {X-14} {Y} {Z-18} {X+14} {Y+7} {Z+22} minecraft:air",
    "fill {X-14} {Y-1} {Z-18} {X+14} {Y-1} {Z+22} minecraft:smooth_stone",
    "?advancement grant @p everything"
   ]
  },
  {
   "do": "wait",
   "ms": 8000
  },
  {
   "label": "runner pause step: Win32 Esc opens the pause menu",
   "do": "pause"
  },
  {
   "name": "pause-menu",
   "do": "shot",
   "look": "the pause menu over the world (26.3 runs SDL3: a missing menu means the runner's Esc post needs changing)"
  },
  {
   "label": "back to the game",
   "do": "click",
   "widgetText": "Back to Game",
   "allowMiss": true
  },
  {
   "do": "expectScreen",
   "contains": "",
   "timeoutSec": 5
  },
  {
   "label": "translucency row",
   "do": "cmd",
   "run": [
    "setblock {X-6} {Y} {Z} minecraft:red_stained_glass",
    "setblock {X-4} {Y-1} {Z} minecraft:water",
    "setblock {X-2} {Y} {Z} buildcraftunofficial:tank",
    "setblock {X-2} {Y+1} {Z} buildcraftunofficial:tank",
    "setblock {X} {Y} {Z} buildcraftunofficial:pipe_holder",
    "data merge block {X} {Y} {Z} {pipe:{def:\"buildcraftunofficial:stone_item\",col:\"lime\"}}",
    "setblock {X} {Y+1} {Z} buildcraftunofficial:pipe_holder",
    "data merge block {X} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:stone_fluid\",col:\"red\"}}",
    "setblock {X+2} {Y} {Z} minecraft:blue_stained_glass_pane",
    "setblock {X+4} {Y} {Z} minecraft:slime_block",
    "setblock {X+6} {Y} {Z} minecraft:honey_block",
    "setblock {X} {Y} {Z-4} minecraft:white_stained_glass",
    "setblock {X-4} {Y} {Z-4} minecraft:white_stained_glass",
    "setblock {X+4} {Y} {Z-4} minecraft:white_stained_glass"
   ]
  },
  {
   "label": "volume markers (x and z axis) and two path markers behind the row",
   "do": "cmd",
   "run": [
    "setblock {X-8} {Y} {Z-3} buildcraftunofficial:marker_volume",
    "setblock {X+8} {Y} {Z-3} buildcraftunofficial:marker_volume",
    "setblock {X-8} {Y} {Z-7} buildcraftunofficial:marker_volume",
    "setblock {X-5} {Y} {Z-9} buildcraftunofficial:marker_path",
    "setblock {X+5} {Y} {Z-9} buildcraftunofficial:marker_path"
   ]
  },
  {
   "do": "tp",
   "at": [
    -2,
    0,
    2
   ],
   "yaw": 180,
   "pitch": 20
  },
  {
   "do": "hold",
   "item": "minecraft:water_bucket"
  },
  {
   "do": "aim",
   "at": [
    -2,
    0,
    0
   ]
  },
  {
   "label": "fill the lower tank with water",
   "do": "use"
  },
  {
   "do": "hold",
   "item": "minecraft:lava_bucket"
  },
  {
   "do": "aim",
   "at": [
    -2,
    1,
    0
   ]
  },
  {
   "label": "fill the upper tank with lava",
   "do": "use"
  },
  {
   "do": "hold",
   "item": "minecraft:air"
  },
  {
   "do": "tp",
   "at": [
    -8,
    0,
    -1
   ],
   "yaw": 180,
   "pitch": 30
  },
  {
   "do": "aim",
   "at": [
    -8,
    0,
    -3
   ]
  },
  {
   "label": "connect the volume markers",
   "do": "use"
  },
  {
   "do": "tp",
   "at": [
    -5,
    0,
    -7
   ],
   "yaw": 180,
   "pitch": 30
  },
  {
   "do": "aim",
   "at": [
    -5,
    0,
    -9
   ]
  },
  {
   "label": "connect the path markers",
   "do": "use"
  },
  {
   "do": "tp",
   "at": [
    0,
    0,
    5
   ],
   "yaw": 180,
   "pitch": 8
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "b1-translucency",
   "do": "shot",
   "look": "B1: red glass, water hole, water tank under a lava tank, lime and red pipes, blue pane, slime, honey; white glass behind; red marker lasers along x and z behind everything and the path laser further back. Compare 26.3 OIT on / off / 26.2: missing or wrongly ordered translucency, lasers vanishing behind glass, a black or garbled surface is the finding"
  },
  {
   "do": "tp",
   "at": [
    -8,
    0,
    -1
   ],
   "yaw": 180,
   "pitch": 40
  },
  {
   "do": "aim",
   "at": [
    -8,
    0,
    -3
   ]
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "name": "b2-markers-close",
   "do": "shot",
   "look": "B2 torch_center_lit (shade_direction_override): volume marker close up, the lit centre and the post's side faces; compare its face shading 26.3 vs 26.2"
  },
  {
   "label": "pipe row",
   "do": "cmd",
   "run": [
    "setblock {X-6} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-6} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:wood_item\"}}",
    "setblock {X-4} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-4} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_fluid\",col:\"red\"}}",
    "setblock {X-2} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-2} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:gold_power\"}}",
    "setblock {X} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:diamond_item\"}}",
    "setblock {X+2} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+2} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:quartz_item\",col:\"blue\"}}",
    "setblock {X+4} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+4} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:stripes_item\"}}",
    "setblock {X+6} {Y} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+6} {Y} {Z+8} {pipe:{def:\"buildcraftunofficial:structure\"}}"
   ]
  },
  {
   "label": "plug row (south faces toward the camera)",
   "do": "cmd",
   "run": [
    "setblock {X-5} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-5} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:facade\",data:{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_planks\"}}]},activeState:0}}}}",
    "setblock {X-3} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-3} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:facade\",data:{facade:{isHollow:0b,states:[{state:{id:\"minecraft:stone_bricks\"}}]},activeState:0}}}}",
    "setblock {X-1} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X-1} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:1b,material:3b,modifier:3b}}}}}}",
    "setblock {X+1} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+1} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:lens\",data:{colour:\"red\",f:0b}}}}",
    "setblock {X+3} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+3} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_power\"},plugs:{south:{id:\"buildcraftunofficial:pulsar\",data:{}}}}",
    "setblock {X+5} {Y+1} {Z+8} buildcraftunofficial:pipe_holder",
    "data merge block {X+5} {Y+1} {Z+8} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:blocker\",data:{}}}}"
   ]
  },
  {
   "label": "dropped items: pipe, facade, gate, lens, robot, lava shard",
   "do": "cmd",
   "run": [
    "summon minecraft:item {X-5}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:pipe_wood_item\",count:1},PickupDelay:32767,NoGravity:1b,Age:-32768}",
    "summon minecraft:item {X-3}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_planks\"}}]}}}},PickupDelay:32767,NoGravity:1b,Age:-32768}",
    "summon minecraft:item {X-1}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:plug_gate\",count:1,components:{\"minecraft:custom_data\":{gate:{logic:0b,material:3b,modifier:3b}}}},PickupDelay:32767,NoGravity:1b,Age:-32768}",
    "summon minecraft:item {X+1}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:plug_lens\",count:1,components:{\"minecraft:custom_data\":{colour:\"red\",isFilter:0b}}},PickupDelay:32767,NoGravity:1b,Age:-32768}",
    "summon minecraft:item {X+3}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:robot\",count:1},PickupDelay:32767,NoGravity:1b,Age:-32768}",
    "summon minecraft:item {X+5}.5 {Y}.2 {Z+11}.5 {Item:{id:\"buildcraftunofficial:fragile_fluid_container\",count:1,components:{\"buildcraftunofficial:fluid_content\":{id:\"minecraft:lava\",amount:1000}}},PickupDelay:32767,NoGravity:1b,Age:-32768}"
   ]
  },
  {
   "do": "tp",
   "at": [
    0,
    1,
    14
   ],
   "yaw": 180,
   "pitch": 18
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "pipes-world",
   "do": "shot",
   "look": "pipes in world: wood, red stone fluid, gold power, diamond, blue quartz, stripes, structure; above: oak facade (legacy Name key), stone-brick facade (26.3 id key), gold gate, red lens, pulsar, blocker; front row dropped: pipe, facade, gate, lens, robot, lava shard (B2 pipe item and chassis shading)"
  },
  {
   "do": "tp",
   "at": [
    0,
    1,
    14
   ],
   "yaw": 180,
   "pitch": 40
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "name": "b2-dropped-close",
   "do": "shot",
   "look": "B2: dropped pipe item, facade, gate, lens, robot and lava shard close up; compare face shading 26.3 vs 26.2 (pipe_item and robot_chassis_base had shade:false)"
  },
  {
   "do": "tp",
   "at": [
    0,
    0,
    13
   ],
   "yaw": 180,
   "pitch": 25
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:pipe_wood_item"
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
