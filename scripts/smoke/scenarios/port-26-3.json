   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "red layer before painting",
   "do": "cmd",
   "run": [
    "data get block {X+9} {Y} {Z-16} layer_14"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "pick up the red brush",
   "do": "click",
   "slotIndex": 0
  },
  {
   "label": "LEFT click on the map (paint one cell)",
   "do": "click",
   "fx": 0.466,
   "fy": 0.271
  },
  {
   "do": "wait",
   "ms": 1000
  },
  {
   "name": "b5-planner-painted",
   "do": "shot",
   "look": "B5: a red cell painted at the map centre, brush on the cursor"
  },
  {
   "label": "B5 red layer after the left click (expect a painted chunk entry)",
   "do": "cmd",
   "run": [
