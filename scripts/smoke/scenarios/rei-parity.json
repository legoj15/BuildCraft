{
  "name": "rei-parity",
  "description": "REI in place of JEI (issue #49): every BuildCraft machine GUI's click area opens its REI category, the side panel keeps clear of ledgers and gate statement lists, and the item list shows BuildCraft's variants. Click points are GUI units at scale 2 (427x240 screen): window left = (427 - width) / 2, top = (240 - height) / 2, plus the JEI click-area rect's centre.",
  "recipeViewer": "rei",
  "base": [0, 150, 0],
  "steps": [
    { "label": "load the rig's chunks", "do": "cmd", "run": ["gamemode creative @p", "?forceload add {X-6} {Z-6} {X+6} {Z+6}"] },
    { "do": "tp", "at": [0, 0, 3], "yaw": 180, "pitch": 30 },
    { "do": "wait", "ms": 3000 },
    { "label": "setup", "do": "cmd", "run": [
      "difficulty peaceful", "time set 6000", "weather clear",
      "fill {X-6} {Y-1} {Z-6} {X+6} {Y-1} {Z+6} minecraft:smooth_stone",
      "?fill {X-6} {Y} {Z-6} {X+6} {Y+4} {Z+6} minecraft:air",
      "setblock {X-4} {Y} {Z} buildcraftunofficial:assembly_table",
      "setblock {X-3} {Y} {Z} buildcraftunofficial:autoworkbench_item",
      "setblock {X-2} {Y} {Z} buildcraftunofficial:distiller",
      "setblock {X-1} {Y} {Z} buildcraftunofficial:heat_exchange",
      "setblock {X} {Y} {Z} buildcraftunofficial:engine_stone",
      "setblock {X+1} {Y} {Z} buildcraftunofficial:engine_iron",
      "setblock {X+2} {Y} {Z} buildcraftunofficial:programming_table",
      "setblock {X+3} {Y} {Z} buildcraftunofficial:integration_table",
      "setblock {X+4} {Y} {Z} buildcraftunofficial:advanced_crafting_table",
      "setblock {X+5} {Y} {Z} buildcraftunofficial:pipe_holder",
      "data merge block {X+5} {Y} {Z} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:1b,material:3b,modifier:3b}}}}}}",
      "?clear @p",
      "give @p minecraft:redstone 64", "give @p minecraft:diamond 64", "give @p buildcraftunofficial:oil_bucket 4",
      "item replace entity @p hotbar.8 with minecraft:air"
    ] },
    { "do": "tp", "at": [0, 0, 3], "yaw": 180, "pitch": 30 },
    { "do": "hold", "item": "minecraft:air" },

    { "do": "aim", "at": [-4, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Assembly Table", "do": "use" },
    { "do": "expectScreen", "contains": "GuiAssemblyTable" },
    { "name": "asm-gui", "do": "shot", "look": "REI item list on the right, its panel clear of the ledgers; no JEI overlay anywhere" },
    { "label": "click the power bar", "do": "click", "x": 213, "y": 70 },
    { "do": "wait", "ms": 1000 },
    { "name": "asm-rei", "do": "shot", "look": "REI recipe screen on the Assembly Table category: inputs, output, MJ cost, Assembly Table as workstation, a '+' button" },
    { "name": "asm-rei", "do": "widgets" },
    { "do": "close" },

    { "do": "aim", "at": [-3, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Auto Workbench", "do": "use" },
    { "do": "expectScreen", "contains": "GuiAutoCraft" },
    { "label": "click the progress arrow", "do": "click", "x": 226, "y": 73 },
    { "do": "wait", "ms": 1000 },
    { "name": "awb-rei", "do": "shot", "look": "REI Crafting category, Auto Workbench listed as a workstation, '+' beside each recipe" },
    { "do": "close" },

    { "do": "aim", "at": [-2, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Distiller", "do": "use" },
    { "do": "expectScreen", "contains": "GuiDistiller" },
    { "label": "click the process schematic", "do": "click", "x": 204, "y": 79 },
    { "do": "wait", "ms": 1000 },
    { "name": "dist-rei", "do": "shot", "look": "REI Distiller category: one fluid in, gas and liquid fractions out, MJ cost, Distiller workstation" },
    { "do": "close" },

    { "do": "aim", "at": [-1, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Heat Exchanger", "do": "use" },
    { "do": "expectScreen", "contains": "GuiHeatExchange" },
    { "label": "click the exchange arrows", "do": "click", "x": 213, "y": 80 },
    { "do": "wait", "ms": 1000 },
    { "name": "hx-rei", "do": "shot", "look": "REI Heat Exchanger category: cold in/out and hot in/out fluid pairs" },
    { "do": "close" },

    { "do": "aim", "at": [0, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Stirling Engine", "do": "use" },
    { "do": "expectScreen", "contains": "ScreenEngineStone" },
    { "label": "click the flame", "do": "click", "x": 213, "y": 69 },
    { "do": "wait", "ms": 1000 },
    { "name": "stirling-rei", "do": "shot", "look": "REI Stirling fuel category listing furnace fuels with burn times (not empty)" },
    { "do": "close" },

    { "do": "aim", "at": [1, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Combustion Engine", "do": "use" },
    { "do": "expectScreen", "contains": "ScreenEngineIron" },
    { "label": "click the tanks", "do": "click", "x": 186, "y": 79 },
    { "do": "wait", "ms": 1000 },
    { "name": "combustion-rei", "do": "shot", "look": "REI Combustion fuel (and coolant tab): fuels with MJ/t and burn time, Combustion Engine workstation" },
    { "do": "close" },

    { "do": "aim", "at": [2, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Programming Table", "do": "use" },
    { "do": "expectScreen", "contains": "GuiProgrammingTable" },
    { "label": "click the power bar", "do": "click", "x": 291, "y": 87 },
    { "do": "wait", "ms": 1000 },
    { "name": "prog-rei", "do": "shot", "look": "REI Programming Table category: board in, programmed board out, MJ cost" },
    { "do": "close" },

    { "do": "aim", "at": [3, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Integration Table", "do": "use" },
    { "do": "expectScreen", "contains": "GuiIntegrationTable" },
    { "label": "click the power bar", "do": "click", "x": 291, "y": 81 },
    { "do": "wait", "ms": 1000 },
    { "name": "integ-rei", "do": "shot", "look": "REI Integration Table category: target + components, result, MJ cost" },
    { "do": "close" },

    { "do": "aim", "at": [4, 0, 0] }, { "do": "wait", "ms": 300 },
    { "label": "open Advanced Crafting Table", "do": "use" },
    { "do": "expectScreen", "contains": "GuiAdvancedCraftingTable" },
    { "name": "act-gui", "do": "shot", "look": "Advanced Crafting Table with REI panel beside it" },
    { "label": "click the progress arrow", "do": "click", "x": 229, "y": 40, "allowMiss": true },
    { "do": "wait", "ms": 1000 },
    { "name": "act-rei", "do": "shot", "look": "REI Crafting category with the Advanced Crafting Table as a workstation" },
    { "do": "close" },

    { "do": "aim", "at": [5, 0, 0], "exact": true }, { "do": "wait", "ms": 300 },
    { "do": "aim", "at": [5, 0, 0.45], "exact": true }, { "do": "wait", "ms": 300 },
    { "label": "open the gate", "do": "use" },
    { "do": "expectScreen", "contains": "GuiGate" },
    { "name": "gate-gui", "do": "shot", "look": "gate GUI: the trigger/action source lists on its sides are not covered by REI's panel" },
    { "do": "close" }
  ]
}
