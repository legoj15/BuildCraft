        "setblock {X-11} {Y} {Z} minecraft:chest",
        "item replace block {X-11} {Y} {Z} container.0 with minecraft:iron_hoe",
        "item replace block {X-11} {Y} {Z} container.1 with minecraft:iron_hoe"
      ]
    },
    {
      "label": "planter home (seeds)",
