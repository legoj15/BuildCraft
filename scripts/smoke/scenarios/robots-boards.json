        "setblock {X+4} {Y} {Z-4} buildcraftunofficial:engine_creative[facing=up]",
        "setblock {X+4} {Y+1} {Z-4} buildcraftunofficial:pipe_holder",
        "data merge block {X+4} {Y+1} {Z-4} {pipe:{def:\"buildcraftunofficial:wood_power\"},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}}}}",
        "setblock {X-2} {Y+1} {Z-4} buildcraftunofficial:pipe_holder",
        "data merge block {X-2} {Y+1} {Z-4} {pipe:{def:\"buildcraftunofficial:wood_item\",beh:{currentDir:\"DOWN\"}},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:2b,modifier:2b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.accept_items\",side:6b}},\"trigger[1]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[1]\":{s:{kind:\"buildcraft:robot.work_in_area\",side:6b},\"0\":{kind:\"buildcraft:maplocation\",stack:{id:\"buildcraftunofficial:map_location\",count:1,components:{\"minecraft:custom_data\":{mapType:\"AREA\",xMin:{X-3},yMin:{Y-1},zMin:{Z-6},xMax:{X-1},yMax:{Y+2},zMax:{Z-3}}}}}}}}}}}",
        "setblock {X-2} {Y} {Z-4} minecraft:chest"
