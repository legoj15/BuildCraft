    },
    {
      "label": "named cow (text component)",
      "do": "cmd",
      "nodes": [
        "1.21.10",
        "1.21.11",
        "26.1.2",
        "26.2",
        "26.3"
      ],
      "run": [
        "summon minecraft:cow {X+2} {Y} {Z+6} {CustomName:\"Daisy\"}"
