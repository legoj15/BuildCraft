      "do": "cmd",
      "run": [
        "data get entity @e[type=buildcraftunofficial:robot,x={X+4},y={Y+2},z={Z-4},distance=..1.5,limit=1] boardId"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "robots alive (expect 7)",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    }
  ]
}
