{
  "name": "robots-boards",
  "description": "Six work boards (Farmer, Planter, Harvester, Butcher, Miner, Shovelman) each confined by a Work-in-Area gate, plus a low-battery robot that should recharge at a creative-engine station. Generated by hand-editable data; the rig is rebuilt every run.",
  "base": [
    0,
    150,
    40
  ],
  "steps": [
    {
      "label": "load chunks",
      "do": "cmd",
      "run": [
        "gamemode creative @p",
        "?forceload add {X-16} {Z-8} {X+16} {Z+18}"
      ]
    },
    {
      "do": "tp",
      "at": [
        0,
        0,
        -7
      ],
      "yaw": 0,
      "pitch": 25
    },
    {
      "do": "wait",
      "ms": 3000
    },
    {
      "label": "clear and floor",
      "do": "cmd",
      "run": [
        "difficulty peaceful",
        "time set 6000",
        "?gamerule doDaylightCycle false",
        "?gamerule advance_time false",
        "weather clear",
        "?kill @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..200]",
        "?kill @e[type=minecraft:item,x={X},y={Y},z={Z},distance=..200]",
        "?kill @e[type=minecraft:cow,x={X},y={Y},z={Z},distance=..200]",
        "?fill {X-16} {Y} {Z-8} {X+16} {Y+6} {Z+12} minecraft:air",
        "fill {X-16} {Y-1} {Z-8} {X+16} {Y-1} {Z+12} minecraft:smooth_stone"
      ]
    },
    {
      "label": "farm plot: dirt, water, a row of ripe wheat",
      "do": "cmd",
      "run": [
        "fill {X-11} {Y-1} {Z+4} {X-5} {Y-1} {Z+8} minecraft:dirt",
        "setblock {X-8} {Y-1} {Z+6} minecraft:water",
        "fill {X-11} {Y-1} {Z+9} {X-5} {Y-1} {Z+9} minecraft:farmland[moisture=7]",
        "fill {X-11} {Y} {Z+9} {X-5} {Y} {Z+9} minecraft:wheat[age=7]"
      ]
    },
    {
      "label": "farmer home (hoe)",
      "do": "cmd",
      "run": [
        "setblock {X-11} {Y+1} {Z} buildcraftunofficial:pipe_holder",
