        "setblock {X-5} {Y} {Z} minecraft:chest"
      ]
    },
    {
      "label": "cow pen",
      "do": "cmd",
      "run": [
        "fill {X-1} {Y} {Z+3} {X+5} {Y} {Z+9} minecraft:oak_fence",
