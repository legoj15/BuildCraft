{
  "name": "robots-logistics",
  "description": "Carrier (station to station), Leave Cutter, Knight (husks, which do not burn in daylight) and Pump (water pool into a tank through an Accept Fluids station). Generated by scratch gen script; edit freely.",
  "base": [
    0,
    150,
    80
  ],
  "steps": [
    {
      "label": "load chunks",
      "do": "cmd",
      "run": [
        "gamemode creative @p",
        "?forceload add {X-16} {Z-8} {X+16} {Z+12}"
      ]
    },
    {
      "do": "tp",
      "at": [
        0,
        0,
        -7
      ],
      "yaw": 0,
      "pitch": 25
    },
    {
      "do": "wait",
      "ms": 3000
    },
    {
      "label": "clear and floor",
      "do": "cmd",
      "run": [
        "difficulty easy",
        "time set 6000",
        "?gamerule doDaylightCycle false",
        "?gamerule advance_time false",
        "weather clear",
        "?kill @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..40]",
        "?kill @e[type=minecraft:item,x={X},y={Y},z={Z},distance=..40]",
        "?kill @e[type=minecraft:husk,x={X},y={Y},z={Z},distance=..40]",
        "?fill {X-16} {Y} {Z-8} {X+16} {Y+6} {Z+10} minecraft:air",
        "fill {X-16} {Y-1} {Z-8} {X+16} {Y-1} {Z+10} minecraft:smooth_stone"
      ]
    },
    {
      "label": "carrier supply (16 cobblestone, Provide Items)",
      "do": "cmd",
      "run": [
        "setblock {X-10} {Y+1} {Z} buildcraftunofficial:pipe_holder",
        "data merge block {X-10} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:wood_item\",beh:{currentDir:\"DOWN\"}},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:2b,modifier:2b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.provide_items\",side:6b}},\"trigger[1]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[1]\":{s:{kind:\"buildcraft:robot.load_unload_area\",side:6b},\"0\":{kind:\"buildcraft:maplocation\",stack:{id:\"buildcraftunofficial:map_location\",count:1,components:{\"minecraft:custom_data\":{mapType:\"AREA\",xMin:{X-11},yMin:{Y-1},zMin:{Z-1},xMax:{X-5},yMax:{Y+3},zMax:{Z+1}}}}}}}}}}}",
        "setblock {X-10} {Y} {Z} minecraft:chest",
        "item replace block {X-10} {Y} {Z} container.0 with minecraft:cobblestone 16"
      ]
    },
    {
      "label": "carrier destination (Accept Items)",
      "do": "cmd",
      "run": [
        "setblock {X-6} {Y+1} {Z} buildcraftunofficial:pipe_holder",
        "data merge block {X-6} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:wood_item\",beh:{currentDir:\"DOWN\"}},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:0b,modifier:0b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.accept_items\",side:6b}}}}}}}",
        "setblock {X-6} {Y} {Z} minecraft:chest"
      ]
    },
    {
      "label": "leaves for the leave cutter",
      "do": "cmd",
      "run": [
        "fill {X-3} {Y+1} {Z+4} {X+1} {Y+2} {Z+6} minecraft:oak_leaves[persistent=true]"
      ]
    },
    {
      "label": "leave cutter home (shears)",
      "do": "cmd",
      "run": [
        "setblock {X-1} {Y+1} {Z} buildcraftunofficial:pipe_holder",
        "data merge block {X-1} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:wood_item\",beh:{currentDir:\"DOWN\"}},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:2b,modifier:2b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.provide_items\",side:6b}},\"trigger[1]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[1]\":{s:{kind:\"buildcraft:robot.work_in_area\",side:6b},\"0\":{kind:\"buildcraft:maplocation\",stack:{id:\"buildcraftunofficial:map_location\",count:1,components:{\"minecraft:custom_data\":{mapType:\"AREA\",xMin:{X-3},yMin:{Y},zMin:{Z+3},xMax:{X+1},yMax:{Y+3},zMax:{Z+7}}}}}}}}}}}",
        "setblock {X-1} {Y} {Z} minecraft:chest",
        "item replace block {X-1} {Y} {Z} container.0 with minecraft:shears"
      ]
    },
    {
      "label": "husk pen",
      "do": "cmd",
      "run": [
        "fill {X+3} {Y} {Z+3} {X+8} {Y+1} {Z+8} minecraft:oak_fence",
        "fill {X+4} {Y} {Z+4} {X+7} {Y+1} {Z+7} minecraft:air",
        "summon minecraft:husk {X+5} {Y} {Z+5} {PersistenceRequired:1b}",
        "summon minecraft:husk {X+6} {Y} {Z+6} {PersistenceRequired:1b}"
      ]
    },
    {
      "label": "knight home (sword)",
      "do": "cmd",
      "run": [
        "setblock {X+5} {Y+1} {Z} buildcraftunofficial:pipe_holder",
        "data merge block {X+5} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:wood_item\",beh:{currentDir:\"DOWN\"}},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:2b,modifier:2b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.provide_items\",side:6b}},\"trigger[1]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[1]\":{s:{kind:\"buildcraft:robot.work_in_area\",side:6b},\"0\":{kind:\"buildcraft:maplocation\",stack:{id:\"buildcraftunofficial:map_location\",count:1,components:{\"minecraft:custom_data\":{mapType:\"AREA\",xMin:{X+3},yMin:{Y-1},zMin:{Z+3},xMax:{X+8},yMax:{Y+3},zMax:{Z+8}}}}}}}}}}}",
        "setblock {X+5} {Y} {Z} minecraft:chest",
        "item replace block {X+5} {Y} {Z} container.0 with minecraft:iron_sword"
      ]
    },
    {
      "label": "water pool (2x2, regenerating)",
      "do": "cmd",
      "run": [
        "fill {X+12} {Y-1} {Z+5} {X+13} {Y-1} {Z+6} minecraft:water"
      ]
    },
    {
      "label": "pump home: tank under a stone fluid pipe, Accept Fluids",
      "do": "cmd",
      "run": [
        "setblock {X+12} {Y+1} {Z} buildcraftunofficial:pipe_holder",
        "data merge block {X+12} {Y+1} {Z} {pipe:{def:\"buildcraftunofficial:stone_fluid\"},plugs:{up:{id:\"buildcraftunofficial:robot_station\",data:{}},north:{id:\"buildcraftunofficial:gate\",data:{data:{variant:{logic:0b,material:2b,modifier:2b},\"trigger[0]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[0]\":{s:{kind:\"buildcraft:station.accept_fluids\",side:6b}},\"trigger[1]\":{s:{kind:\"buildcraftunofficial:trigger.true\",side:6b}},\"action[1]\":{s:{kind:\"buildcraft:robot.work_in_area\",side:6b},\"0\":{kind:\"buildcraft:maplocation\",stack:{id:\"buildcraftunofficial:map_location\",count:1,components:{\"minecraft:custom_data\":{mapType:\"AREA\",xMin:{X+11},yMin:{Y-2},zMin:{Z+4},xMax:{X+14},yMax:{Y+1},zMax:{Z+7}}}}}}}}}}}",
        "setblock {X+12} {Y} {Z} buildcraftunofficial:tank"
      ]
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "name": "rig3-empty",
      "do": "shot",
      "look": "left to right (screen right to left): carrier supply + destination stations, leaf block, husk pen with two husks, water pool by a tank"
    },
    {
      "label": "deploy carrier at the supply station",
      "do": "tp",
      "at": [
        -10,
        2,
        0
      ],
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "hold",
      "item": "buildcraftunofficial:robot[minecraft:custom_data={board:{id:\"buildcraftunofficial:boardRobotCarrier\"},energy:5000000000L}]"
    },
    {
      "do": "look",
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "use"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "label": "count after carrier",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "deploy leave cutter",
      "do": "tp",
      "at": [
        -1,
        2,
        0
      ],
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "hold",
      "item": "buildcraftunofficial:robot[minecraft:custom_data={board:{id:\"buildcraftunofficial:boardRobotLeaveCutter\"},energy:5000000000L}]"
    },
    {
      "do": "look",
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "use"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "label": "count after leave cutter",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "held after leave cutter deploy",
      "do": "cmd",
      "run": [
        "data get entity @p SelectedItem"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "deploy knight",
      "do": "tp",
      "at": [
        5,
        2,
        0
      ],
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "hold",
      "item": "buildcraftunofficial:robot[minecraft:custom_data={board:{id:\"buildcraftunofficial:boardRobotKnight\"},energy:5000000000L}]"
    },
    {
      "do": "look",
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "use"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "label": "count after knight",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "deploy pump",
      "do": "tp",
      "at": [
        12,
        2,
        0
      ],
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "hold",
      "item": "buildcraftunofficial:robot[minecraft:custom_data={board:{id:\"buildcraftunofficial:boardRobotPump\"},energy:5000000000L}]"
    },
    {
      "do": "look",
      "yaw": 0,
      "pitch": 90
    },
    {
      "do": "use"
    },
    {
      "do": "wait",
      "ms": 500
    },
    {
      "do": "hold",
      "item": "minecraft:air"
    },
    {
      "label": "robots deployed (expect 4)",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "viewing pillar",
      "do": "cmd",
      "run": [
        "setblock {X+1} {Y+3} {Z-7} minecraft:glass"
      ]
    },
    {
      "do": "tp",
      "at": [
        1,
        4,
        -7
      ],
      "yaw": 0,
      "pitch": 30
    },
    {
      "do": "wait",
      "ms": 10000
    },
    {
      "name": "rig3-10s",
      "do": "shot",
      "look": "carrier carrying cobblestone between stations, leave cutter at the leaves with shears, knight fighting husks, pump at the pool"
    },
    {
      "do": "wait",
      "ms": 30000
    },
    {
      "name": "rig3-40s",
      "do": "shot",
      "look": "leaves cut, husks dead, pump going back and forth to the tank; no robot stuck"
    },
    {
      "do": "wait",
      "ms": 30000
    },
    {
      "name": "rig3-70s",
      "do": "shot",
      "look": "steady state; robots docked or working; floor intact"
    },
    {
      "label": "cobblestone reached the destination chest",
      "do": "cmd",
      "run": [
        "data get block {X-6} {Y} {Z} Items"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "supply chest left",
      "do": "cmd",
      "run": [
        "data get block {X-10} {Y} {Z} Items"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "husks left (expect fail)",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=minecraft:husk,x={X+5},y={Y},z={Z+5},distance=..6]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "leaves left (count; destructive)",
      "do": "cmd",
      "run": [
        "fill {X-3} {Y+1} {Z+4} {X+1} {Y+2} {Z+6} minecraft:air replace minecraft:oak_leaves"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "tank contents (expect water)",
      "do": "cmd",
      "run": [
        "data get block {X+12} {Y} {Z}"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "pump robot tank",
      "do": "cmd",
      "run": [
        "data get entity @e[type=buildcraftunofficial:robot,x={X+12},y={Y+2},z={Z},distance=..12,limit=1,sort=nearest] tank"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "Carrier alive",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,nbt={boardId:\"buildcraftunofficial:boardRobotCarrier\"}]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "LeaveCutter alive",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,nbt={boardId:\"buildcraftunofficial:boardRobotLeaveCutter\"}]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "Knight alive",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,nbt={boardId:\"buildcraftunofficial:boardRobotKnight\"}]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "Pump alive",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,nbt={boardId:\"buildcraftunofficial:boardRobotPump\"}]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "pump robot full",
      "do": "cmd",
      "run": [
        "data get entity @e[type=buildcraftunofficial:robot,nbt={boardId:\"buildcraftunofficial:boardRobotPump\"},limit=1]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "pump station pipe",
      "do": "cmd",
      "run": [
        "data get block {X+12} {Y+1} {Z}"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "robots alive (expect 4)",
      "do": "cmd",
      "run": [
        "execute if entity @e[type=buildcraftunofficial:robot,x={X},y={Y},z={Z},distance=..30]"
      ],
      "allowFail": true,
      "echo": true
    },
    {
      "label": "back to peaceful",
      "do": "cmd",
      "run": [
        "difficulty peaceful"
      ]
    }
  ]
}
