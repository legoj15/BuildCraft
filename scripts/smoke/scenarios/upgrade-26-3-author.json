{
 "name": "upgrade-26-3-author",
 "description": "B0/B8 world upgrade, part 1 (run on 26.2): blueprints, a template, the library list and facades saved by 26.2. Generated by generators/gen_upgrade_26_3.py, whose docstring has the carry-over steps.",
 "base": [
  0,
  150,
  0
 ],
 "save": "bc-upgrade",
 "saveSeed": "bc-smoke",
 "steps": [
  {
   "label": "load the rig's chunks",
   "do": "cmd",
   "run": [
    "gamemode creative @p",
    "?forceload add {X-16} {Z-16} {X+24} {Z+24}"
   ]
  },
  {
   "do": "tp",
   "at": [
    6,
    0,
    16
   ],
   "yaw": 180,
   "pitch": 10
  },
  {
   "do": "wait",
   "ms": 3000
  },
  {
   "label": "clear and floor",
   "do": "cmd",
   "run": [
    "difficulty peaceful",
    "time set 6000",
    "weather clear",
    "?clear @p",
    "?kill @e[type=minecraft:item,x={X},y={Y},z={Z},distance=..40]",
    "?fill {X-6} {Y} {Z-8} {X+20} {Y+6} {Z+20} minecraft:air",
    "fill {X-6} {Y-1} {Z-8} {X+20} {Y-1} {Z+20} minecraft:smooth_stone",
    "?advancement grant @p everything"
   ]
  },
  {
   "do": "wait",
   "ms": 4000
  },
  {
   "label": "structure A (directional, axis, slab, double-slab states and a walled water source)",
   "do": "cmd",
   "run": [
    "setblock {X} {Y} {Z} minecraft:oak_log[axis=x]",
    "setblock {X+1} {Y} {Z} minecraft:oak_log[axis=x]",
    "setblock {X+2} {Y} {Z} minecraft:oak_log[axis=x]",
    "setblock {X} {Y} {Z+1} minecraft:birch_log[axis=z]",
    "setblock {X+1} {Y} {Z+1} minecraft:water",
    "setblock {X+2} {Y} {Z+1} minecraft:birch_log[axis=z]",
    "setblock {X} {Y} {Z+2} minecraft:oak_log[axis=x]",
    "setblock {X+1} {Y} {Z+2} minecraft:oak_log[axis=x]",
    "setblock {X+2} {Y} {Z+2} minecraft:oak_log[axis=x]",
    "setblock {X} {Y+1} {Z} minecraft:oak_stairs[facing=east,half=bottom]",
    "setblock {X+1} {Y+1} {Z} minecraft:stone_slab[type=top]",
    "setblock {X+2} {Y+1} {Z} minecraft:oak_stairs[facing=west,half=top]",
    "setblock {X} {Y+1} {Z+1} minecraft:smooth_stone_slab[type=bottom]",
    "setblock {X+2} {Y+1} {Z+1} minecraft:purpur_pillar[axis=x]",
    "setblock {X} {Y+1} {Z+2} minecraft:oak_slab[type=double]",
    "setblock {X+1} {Y+1} {Z+2} minecraft:stone_brick_stairs[facing=north,half=top]",
    "setblock {X+2} {Y+1} {Z+2} minecraft:hay_block[axis=z]"
   ]
  },
  {
   "label": "structure B",
   "do": "cmd",
   "run": [
    "setblock {X} {Y} {Z+6} minecraft:spruce_log[axis=z]",
    "setblock {X+1} {Y} {Z+6} minecraft:oak_stairs[facing=south,half=top]",
    "setblock {X} {Y} {Z+7} minecraft:andesite_slab[type=top]",
    "setblock {X+1} {Y} {Z+7} minecraft:bone_block[axis=x]",
    "setblock {X} {Y+1} {Z+6} minecraft:dark_oak_stairs[facing=west,half=bottom]",
    "setblock {X+1} {Y+1} {Z+7} minecraft:birch_slab[type=bottom]"
   ]
  },
  {
   "label": "architect tables: blueprint A, template T (of A), blueprint B",
   "do": "cmd",
   "run": [
    "setblock {X+1} {Y} {Z-2} buildcraftunofficial:architect[facing=north]",
    "data merge block {X+1} {Y} {Z-2} {box_initialized:1b,box_minX:{X},box_minY:{Y},box_minZ:{Z},box_maxX:{X+2},box_maxY:{Y+1},box_maxZ:{Z+2},isValid:1b,name:\"upgrade-a\",items:{in:{items:[{stack:{id:\"buildcraftunofficial:blueprint_clean\",count:1}}]},out:{items:[]}}}"
   ]
  },
  {
   "label": "architect A finished its blueprint",
   "do": "waitCmd",
   "run": "data get block {X+1} {Y} {Z-2} items.out.items[0].stack.id",
   "match": "blueprint_used",
   "timeoutSec": 30
  },
  {
   "label": "template architect",
   "do": "cmd",
   "run": [
    "setblock {X+4} {Y} {Z-2} buildcraftunofficial:architect[facing=north]",
    "data merge block {X+4} {Y} {Z-2} {box_initialized:1b,box_minX:{X},box_minY:{Y},box_minZ:{Z},box_maxX:{X+2},box_maxY:{Y+1},box_maxZ:{Z+2},isValid:1b,name:\"upgrade-t\",items:{in:{items:[{stack:{id:\"buildcraftunofficial:template_clean\",count:1}}]},out:{items:[]}}}"
   ]
  },
  {
   "label": "architect T finished its template",
   "do": "waitCmd",
   "run": "data get block {X+4} {Y} {Z-2} items.out.items[0].stack.id",
   "match": "template_used",
   "timeoutSec": 30
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "label": "blueprint B architect",
   "do": "cmd",
   "run": [
    "setblock {X} {Y} {Z+4} buildcraftunofficial:architect[facing=north]",
    "data merge block {X} {Y} {Z+4} {box_initialized:1b,box_minX:{X},box_minY:{Y},box_minZ:{Z+6},box_maxX:{X+1},box_maxY:{Y+1},box_maxZ:{Z+7},isValid:1b,name:\"upgrade-b\",items:{in:{items:[{stack:{id:\"buildcraftunofficial:blueprint_clean\",count:1}}]},out:{items:[]}}}"
   ]
  },
  {
   "label": "architect B finished its blueprint",
   "do": "waitCmd",
   "run": "data get block {X} {Y} {Z+4} items.out.items[0].stack.id",
   "match": "blueprint_used",
   "timeoutSec": 30
  },
  {
   "label": "chest: facade items, blanks, then the used blueprint A and template T; the library beside it",
   "do": "cmd",
   "run": [
    "setblock {X+6} {Y} {Z+4} buildcraftunofficial:library[facing=south]",
    "setblock {X+8} {Y} {Z+4} minecraft:chest[facing=south]",
    "data merge block {X+8} {Y} {Z+4} {Items:[{Slot:2b,id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_log\",Properties:{axis:\"z\"}}}]}}}},{Slot:3b,id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:1b,states:[{state:{Name:\"minecraft:purpur_pillar\",Properties:{axis:\"x\"}}}]}}}},{Slot:4b,id:\"buildcraftunofficial:plug_facade\",count:1,components:{\"minecraft:custom_data\":{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:quartz_pillar\",Properties:{axis:\"x\"}}},{state:{Name:\"minecraft:red_wool\"},activeColour:\"RED\"}]}}}},{Slot:5b,id:\"buildcraftunofficial:blueprint_clean\",count:2},{Slot:6b,id:\"buildcraftunofficial:template_clean\",count:1}]}",
    "data modify block {X+8} {Y} {Z+4} Items append value {Slot:0b,id:\"minecraft:stone\",count:1}",
    "data modify block {X+8} {Y} {Z+4} Items[{Slot:0b}] merge from block {X+1} {Y} {Z-2} items.out.items[0].stack",
    "data modify block {X+8} {Y} {Z+4} Items append value {Slot:1b,id:\"minecraft:stone\",count:1}",
    "data modify block {X+8} {Y} {Z+4} Items[{Slot:1b}] merge from block {X+4} {Y} {Z-2} items.out.items[0].stack"
   ]
  },
  {
   "label": "chest contents as 26.2 saved them",
   "do": "cmd",
   "run": [
    "data get block {X+8} {Y} {Z+4} Items"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "facade pipes: hollow purpur and phased by NBT, two bare pipes for item use",
   "do": "cmd",
   "run": [
    "setblock {X+2} {Y} {Z+12} buildcraftunofficial:pipe_holder",
    "data merge block {X+2} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:facade\",data:{facade:{isHollow:1b,states:[{state:{Name:\"minecraft:purpur_pillar\",Properties:{axis:\"x\"}}}]},activeState:0}}}}",
    "setblock {X+4} {Y} {Z+12} buildcraftunofficial:pipe_holder",
    "data merge block {X+4} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:stone_item\"},plugs:{south:{id:\"buildcraftunofficial:facade\",data:{facade:{isHollow:0b,states:[{state:{Name:\"minecraft:quartz_pillar\",Properties:{axis:\"x\"}}},{state:{Name:\"minecraft:red_wool\"},activeColour:\"RED\"}]},activeState:0}}}}",
    "setblock {X} {Y} {Z+12} buildcraftunofficial:pipe_holder",
    "data merge block {X} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:stone_item\"}}",
    "setblock {X+6} {Y} {Z+12} buildcraftunofficial:pipe_holder",
    "data merge block {X+6} {Y} {Z+12} {pipe:{def:\"buildcraftunofficial:stone_item\"}}"
   ]
  },
  {
   "do": "tp",
   "at": [
    0,
    0,
    14
   ],
   "yaw": 180,
   "pitch": 0
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:plug_facade[minecraft:custom_data={facade:{isHollow:0b,states:[{state:{Name:\"minecraft:oak_log\",Properties:{axis:\"z\"}}}]}}]"
  },
  {
   "do": "aim",
   "at": [
    0,
    0,
    12
   ]
  },
  {
   "label": "place the oak-log (axis z) facade by hand",
   "do": "use"
  },
  {
   "do": "tp",
   "at": [
    6,
    0,
    14
   ],
   "yaw": 180,
   "pitch": 0
  },
  {
   "do": "hold",
   "item": "buildcraftunofficial:plug_facade[minecraft:custom_data={facade:{isHollow:1b,states:[{state:{Name:\"minecraft:birch_log\",Properties:{axis:\"x\"}}}]}}]"
  },
  {
   "do": "aim",
   "at": [
    6,
    0,
    12
   ]
  },
  {
   "label": "place the hollow birch-log (axis x) facade by hand",
   "do": "use"
  },
  {
   "do": "hold",
   "item": "minecraft:air"
  },
  {
   "label": "pipe 1 facade as 26.2 saves it (Name/Properties keys)",
   "do": "cmd",
   "run": [
    "data get block {X} {Y} {Z+12} plugs"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "pipe 2 facade as 26.2 saves it (Name/Properties keys)",
   "do": "cmd",
   "run": [
    "data get block {X+2} {Y} {Z+12} plugs"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "pipe 3 facade as 26.2 saves it (Name/Properties keys)",
   "do": "cmd",
   "run": [
    "data get block {X+4} {Y} {Z+12} plugs"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "pipe 4 facade as 26.2 saves it (Name/Properties keys)",
   "do": "cmd",
   "run": [
    "data get block {X+6} {Y} {Z+12} plugs"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "do": "tp",
   "at": [
    6,
    0,
    8
   ],
   "yaw": 180,
   "pitch": 0
  },
  {
   "do": "aim",
   "at": [
    6,
    0,
    4
   ]
  },
  {
   "label": "open the Electronic Library",
   "do": "use"
  },
  {
   "do": "expectScreen",
   "contains": "Library",
   "timeoutSec": 10
  },
  {
   "label": "library: download A",
   "do": "cmd",
   "run": [
    "data modify block {X+6} {Y} {Z+4} items.downOut.items set value []",
    "data modify block {X+6} {Y} {Z+4} items.downIn.items set from block {X+1} {Y} {Z-2} items.out.items"
   ]
  },
  {
   "label": "library: A downloaded",
   "do": "waitCmd",
   "run": "data get block {X+6} {Y} {Z+4} items.downOut.items[0].stack.id",
   "match": "_used",
   "timeoutSec": 20
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "label": "library: download B",
   "do": "cmd",
   "run": [
    "data modify block {X+6} {Y} {Z+4} items.downOut.items set value []",
    "data modify block {X+6} {Y} {Z+4} items.downIn.items set from block {X} {Y} {Z+4} items.out.items"
   ]
  },
  {
   "label": "library: B downloaded",
   "do": "waitCmd",
   "run": "data get block {X+6} {Y} {Z+4} items.downOut.items[0].stack.id",
   "match": "_used",
   "timeoutSec": 20
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "label": "library: download T",
   "do": "cmd",
   "run": [
    "data modify block {X+6} {Y} {Z+4} items.downOut.items set value []",
    "data modify block {X+6} {Y} {Z+4} items.downIn.items set from block {X+4} {Y} {Z-2} items.out.items"
   ]
  },
  {
   "label": "library: T downloaded",
   "do": "waitCmd",
   "run": "data get block {X+6} {Y} {Z+4} items.downOut.items[0].stack.id",
   "match": "_used",
   "timeoutSec": 20
  },
  {
   "do": "wait",
   "ms": 500
  },
  {
   "do": "wait",
   "ms": 1000
  },
  {
   "name": "library-list",
   "do": "shot",
   "look": "Electronic Library list: upgrade-a, upgrade-b, upgrade-t (26.2, as downloaded)"
  },
  {
   "name": "library",
   "do": "widgets"
  },
  {
   "do": "close"
  },
  {
   "label": "empty the library's slots",
   "do": "cmd",
   "run": [
    "data modify block {X+6} {Y} {Z+4} items.downOut.items set value []"
   ]
  },
  {
   "do": "tp",
   "at": [
    6,
    0,
    19
   ],
   "yaw": 180,
   "pitch": 8
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "facades",
   "do": "shot",
   "look": "four pipes, left to right: oak log (bark facing you, axis z), hollow purpur pillar (axis x), phased facade showing quartz pillar (axis x), hollow birch log (axis x)"
  },
  {
   "label": "a glass block to stand on above the structures",
   "do": "cmd",
   "run": [
    "setblock {X+6} {Y+3} {Z-6} minecraft:glass"
   ]
  },
  {
   "do": "tp",
   "at": [
    6,
    4,
    -6
   ],
   "yaw": 0,
   "pitch": 40
  },
  {
   "do": "wait",
   "ms": 1500
  },
  {
   "name": "structures",
   "do": "shot",
   "look": "structure A (front left) and B (behind it): stairs, slabs, logs, water; nothing east yet"
  },
  {
   "label": "save the world",
   "do": "cmd",
   "run": [
    "save-all flush"
   ],
   "allowFail": true,
   "echo": true
  },
  {
   "label": "pause menu",
   "do": "pause"
  },
  {
   "label": "save and quit",
   "do": "click",
   "widgetText": "Save and Quit to Title"
  },
  {
   "do": "expectScreen",
   "contains": "TitleScreen",
   "timeoutSec": 60
  }
 ]
}
