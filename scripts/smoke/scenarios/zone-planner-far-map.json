      "do": "expectScreen",
      "contains": "GuiZonePlanner"
    },
    {
      "do": "wait",
      "ms": 3000
    },
    {
      "name": "default-zoom",
      "do": "shot",
      "look": "default zoom: terrain around the planner, from the client's own chunks"
    },
    {
      "label": "zoom fully out",
      "do": "scroll",
      "fx": 0.466,
      "fy": 0.271,
      "scrollY": -1,
      "notches": 30
    },
    {
      "do": "wait",
      "ms": 2000
    },
    {
      "name": "survey-zoom",
      "do": "shot",
      "look": "fully zoomed out: besides the small detailed patch in the centre (render distance 4), terrain also shows along a cross and a ring ~560 blocks out where the player toured; gaps elsewhere. Far terrain is coarser (4-block cells) but placed consistently with the centre (no seams/offsets)"
    },
    {
      "label": "zoom in a bit",
      "do": "scroll",
      "fx": 0.466,
      "fy": 0.271,
      "scrollY": 1,
      "notches": 6
    },
    {
      "do": "wait",
      "ms": 1500
    },
    {
      "name": "mid-zoom",
      "do": "shot",
      "look": "intermediate zoom: the near patch joins the toured cross arms without a visible offset or height jump"
    },
    {
      "do": "close"
    }
