{
  "schemaVersion": 1,
  "id": "buildcraftunofficial",
  "version": "${mod_version}",
  "name": "BuildCraft Redux",
  "description": "Extending Minecraft with pipes, auto-crafting, quarries, engines and much more!\nA fan-made continuation reuniting BuildCraft 7 and 8.",
  "authors": ["SpaceToad", "BuildCraft Team", "legoj15 (1.21.1+ port)"],
  "contact": {
    "homepage": "https://github.com/legoj15/BuildCraft",
    "sources": "https://github.com/legoj15/BuildCraft",
    "issues": "https://github.com/legoj15/BuildCraft/issues"
  },
  "license": "MPL-2.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["buildcraft.platform.fabric.BCFabricEntrypoint"],
    "client": ["buildcraft.platform.fabric.client.BCFabricClientEntrypoint"],
    "jei_mod_plugin": [
      "buildcraft.core.compat.jei.BCCoreJeiPlugin",
      "buildcraft.energy.compat.jei.BCEnergyJeiPlugin",
      "buildcraft.factory.compat.jei.BCFactoryJeiPlugin",
      "buildcraft.robotics.compat.jei.BCRoboticsJeiPlugin",
      "buildcraft.silicon.compat.jei.BCSiliconJeiPlugin"
    ],
    "rei_client": [
      "buildcraft.core.compat.rei.BCCoreReiClientPlugin",
      "buildcraft.energy.compat.rei.BCEnergyReiPlugin",
      "buildcraft.factory.compat.rei.BCFactoryReiPlugin",
      "buildcraft.robotics.compat.rei.BCRoboticsReiPlugin",
      "buildcraft.silicon.compat.rei.BCSiliconReiPlugin"
    ],
    "rei_common": [
      "buildcraft.core.compat.rei.BCCoreReiPlugin",
      "buildcraft.robotics.compat.rei.BCRoboticsReiCommonPlugin",
      "buildcraft.silicon.compat.rei.BCSiliconReiCommonPlugin"
    ]
  },
  "mixins": [
    "buildcraftunofficial.mixins.json"
  ],
  "accessWidener": "buildcraftunofficial.classtweaker",
  "depends": {
    "fabricloader": "${fabric_loader_dep_range}",
    "fabric-api": "${fabric_api_dep_range}",
    "minecraft": "~${minecraft_version}",
    "forgeconfigapiport": "${forge_config_api_port_dep_range}",
    "common-protection-api": "${common_protection_api_dep_range}"
  }
}
